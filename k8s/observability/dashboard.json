{
  "uid": "sandbox-routing",
  "title": "Sandbox Routing POC",
  "tags": [
    "sandbox",
    "istio",
    "routing"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "sandbox",
        "label": "Sandbox ID",
        "type": "textbox",
        "query": "test-123",
        "current": {
          "text": "test-123",
          "value": "test-123"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this dashboard",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Send a request with **no header** and one with **X-Sandbox-ID: test-123**, then compare the panels below.\n\nThe applications always call `http://service-c`. The version that answers is chosen by the Istio `VirtualService`, never by application code. Service D has no sandbox deployment and must stay on `baseline` in every case."
      }
    },
    {
      "id": 8,
      "type": "nodeGraph",
      "title": "Service graph \u2014 who calls whom",
      "description": "Built from Tempo service-graph metrics. Nodes are services, edges are calls. Send traffic with and without the sandbox header and watch which service-c node lights up.",
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Calls per edge (service graph metrics)",
      "description": "Request rate per client -> server pair, straight from the service-graph metrics Tempo writes to Prometheus.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client, server) (rate(traces_service_graph_request_total[$__rate_interval]))",
          "legendFormat": "{{client}} -> {{server}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Database calls per version \u2014 which Postgres is being hit",
      "description": "Tempo classifies these edges as connection_type=database. The service_version dimension shows that the baseline deployments talk to postgres-baseline and the sandbox deployments talk to the migrated postgres-sandbox clone.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client, service_version) (rate(traces_service_graph_request_total{connection_type=\"database\"}[$__rate_interval]))",
          "legendFormat": "{{client}} \u2192 postgres-{{service_version}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*baseline.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*sandbox.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Which version of service-c answered",
      "description": "Split of requests between the baseline and sandbox deployments of service-c.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_version) (count_over_time({job=\"service-c\"} |= \"received request\" [$__auto]))",
          "queryType": "range"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "service-c requests per version over time",
      "description": "Each spike shows which deployment Istio selected for that request.",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 8,
        "y": 35
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_version) (count_over_time({job=\"service-c\"} |= \"received request\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "service-c {{service_version}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_version) (count_over_time({job=\"service-d\"} |= \"received request\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "service-d {{service_version}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "service-c BASELINE \u2014 requests received",
      "description": "Should log every request except the ones matching the sandbox rule.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"service-c\", service_version=\"baseline\"} |= \"received request\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "service-c SANDBOX \u2014 requests received",
      "description": "Should log only the requests carrying the matching X-Sandbox-ID.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"service-c\", service_version=\"sandbox\"} |= \"received request\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Header propagation across the whole chain",
      "description": "One row per service that received a request. The sandbox id is the same across the chain; the version column is what Istio chose.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 53
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=~\"service-.+\"} |= `received request` | json body=\"body\", trace_id=\"traceid\" | line_format `{{.body}}` | pattern `service=<service> version=<version> received request sandbox_id=<sandbox_id>`",
          "queryType": "range"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "labels": true,
              "Line": true,
              "tsNs": true,
              "id": true,
              "body": true,
              "level": true,
              "detected_level": true,
              "service_name": true,
              "service_version": true,
              "job": true
            },
            "indexByName": {
              "Time": 0,
              "service": 1,
              "version": 2,
              "sandbox_id": 3,
              "trace_id": 4
            },
            "renameByName": {
              "service": "Service",
              "version": "Version",
              "sandbox_id": "Sandbox ID",
              "trace_id": "Trace ID"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Time",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Version"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "baseline": {
                        "color": "blue",
                        "index": 0
                      },
                      "sandbox": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sandbox ID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "<none>": {
                        "text": "\u2014 none \u2014",
                        "color": "text",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Trace ID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace in Tempo",
                    "url": "/explore?left=%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22query%22:%22${__value.raw}%22,%22queryType%22:%22traceql%22%7D%5D%7D"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 7,
      "type": "traces",
      "title": "Traces \u2014 follow one request through the chain",
      "description": "Open a trace to see A -> B -> C/D as spans. The service.version on the service-c span is the deployment Istio routed to.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 63
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"service-a\" }",
          "limit": 20
        }
      ]
    }
  ]
}
